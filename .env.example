# Copy to .env and fill in. token-eval only uses these for token counting.
# Without ANTHROPIC_API_KEY, Claude token counts fall back to a tiktoken estimate.
ANTHROPIC_API_KEY=

# Optional: OpenAI key (not used by token-eval itself; for your own tracked calls).
OPENAI_API_KEY=

# Optional overrides
# TOKEN_EVAL_DB=tokens.db
# TOKEN_EVAL_PRICING=/path/to/pricing.json
# TOKEN_EVAL_OFFLINE=1   # never call the network for counting
